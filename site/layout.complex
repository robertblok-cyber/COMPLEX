// RobertBlok.com — Fullstack development
//
// Shared data and layout for complex.robertblok.com.
// Everything in this folder is one program; files only group it.

let site = {
  name:    "complex",
  tagline: "one language for the whole web application",
  author:  "Robert Blok",
  github:  "https://github.com/robertblok-cyber/COMPLEX"
}

let nav = [
  { href: "/",           label: "~" },
  { href: "/why",        label: "why" },
  { href: "/language",   label: "language" },
  { href: "/privacy",    label: "privacy" },
  { href: "/roadmap",    label: "roadmap" }
]

// The page shell: head, header with navigation, content, footer.
component layout(title: Text, current: Text) {
  html(lang: "en") {
    head {
      meta(charset: "utf-8")
      meta(name: "viewport", content: "width=device-width, initial-scale=1")
      title { title + " — " + site.name }
      meta(name: "description", content: site.name + ": " + site.tagline)
      link(rel: "stylesheet", href: "/style.css")
      link(rel: "icon", href: "/favicon.svg", type: "image/svg+xml")
    }
    body {
      header(class: "top") {
        a(class: "brand", href: "/") {
          span(class: "prompt") { "$" }, " ", site.name
        }
        nav {
          for item in nav {
            if item.href == current {
              a(href: item.href, class: "active", "aria-current": "page") { item.label }
            } else {
              a(href: item.href) { item.label }
            }
          }
        }
      }
      main { children }
      footer {
        span { "© " + year() + " " + site.author }
        span(class: "dim") { " · this page is a .complex file, rendered by complex 0.2 · " }
        a(href: site.github) { "source" }
      }
    }
  }
}

// A line that looks like a shell command, used as a section heading.
component cmd(text: Text) {
  p(class: "cmd") { span(class: "prompt") { "$ " }, text }
}

// A block of Complex source, shown as code.
component src(code: Text) {
  pre(class: "src") { code }
}
